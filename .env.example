# Server
ADDR=:8080
SITE_NAME=CQUPT Minecraft

# Optional: comma-separated IPs/CIDRs allowed to supply X-Forwarded-For.
# Keep empty unless requests arrive through a proxy whose address is trusted.
TRUSTED_PROXY_CIDRS=

# Database: sqlite or mysql
DB_DRIVER=sqlite
DB_DSN=auth.db

# For MySQL, use for example:
# DB_DRIVER=mysql
# DB_DSN=mc_user:change-me@tcp(127.0.0.1:3306)/mc_auth?parseTime=true

# Set this to the Chongqing University of Posts and Telecommunications
# unified-account number of the site administrator.
ADMIN_STUDENT_ID=2024000000
